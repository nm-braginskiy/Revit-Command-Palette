<Window x:Class="CommandPalette.UI.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="600"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MaxHeight="520"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <FontFamily x:Key="MonoFont">JetBrains Mono, Consolas, monospace</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI, sans-serif</FontFamily>
    </Window.Resources>

    <!-- Внешний Border — только тень, без клипа -->
    <Border Margin="20"
            CornerRadius="8"
            Background="Transparent">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20"
                              ShadowDepth="0" Opacity="0.18"/>
        </Border.Effect>

        <!-- Внутренний Border — клип + визуал -->
        <Border CornerRadius="8"
                Background="#FFFFFF"
                BorderBrush="#D4D4D4"
                BorderThickness="1"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка поиска -->
                <Border Grid.Row="0"
                        BorderBrush="#E5E5E5"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="⌕"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="13"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <Grid Grid.Column="1">
                            <TextBlock x:Name="Placeholder"
                                       Text="Поиск команд..."
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="14"
                                       Foreground="#BBBBBB"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     Foreground="#1E1E1E"
                                     BorderThickness="0"
                                     FontFamily="{StaticResource UiFont}"
                                     FontSize="14"
                                     Padding="0,13"
                                     CaretBrush="#0078D4"
                                     SelectionBrush="#0078D4"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>

                        <!-- ESC badge -->
                        <Border Grid.Column="2"
                                Background="#F3F3F3"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="5,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="ESC"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="#999999"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Список результатов -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="380">
                    <StackPanel>

                        <!-- Метка секции -->
                        <TextBlock x:Name="SectionLabel"
                                   Text="НЕДАВНИЕ"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="#999999"
                                   Margin="14,10,14,5"/>

                        <ListView x:Name="CommandList"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  SelectionChanged="CommandList_SelectionChanged"
                                  MouseLeftButtonUp="CommandList_MouseLeftButtonUp"
                                  KeyDown="CommandList_KeyDown"
                                  PreviewMouseWheel="CommandList_PreviewMouseWheel"
                                  IsTabStop="False">

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="2,0,0,0"
                                                        Padding="12,7">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <!-- Светло-серое при наведении мыши -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                    </Trigger>
                                                    <!-- Синее при выборе стрелками (приоритет выше) -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E5F3FF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Source="{Binding Icon}"
                                               Width="18" Height="18"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="Segoe UI"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       Foreground="#1E1E1E"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#999999"
                                                       Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDescription}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>